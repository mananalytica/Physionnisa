# MotherDuck — get a token from https://app.motherduck.com (Settings > Tokens)
# The Vercel "MotherDuck" marketplace integration fills these in automatically
# when you install it on your project.
MOTHERDUCK_TOKEN=md_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOTHERDUCK_DATABASE=physionnisa

# Postgres wire-protocol endpoint MotherDuck exposes for server-side (pg) access.
# us-east-1 (default) or eu-central-1 — see MotherDuck docs for your org region.
MOTHERDUCK_PG_HOST=pg.us-east-1-aws.motherduck.com
MOTHERDUCK_PG_PORT=5432

# Base URL used in a couple of server-rendered fetches
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel (/admin) — protects product & specialist management
ADMIN_PASSWORD=choose-a-strong-password
# Optional: a separate secret for signing admin session cookies.
# Falls back to ADMIN_PASSWORD if not set — fine for a single-admin setup,
# but set this separately if you ever rotate the password without wanting
# to invalidate itself via a different mechanism.
ADMIN_SESSION_SECRET=

# Patient/specialist accounts (/login, /signup, /account)
AUTH_SESSION_SECRET=choose-a-long-random-string
